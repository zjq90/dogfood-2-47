<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.mapper.BillMapper">
    
    <resultMap id="BaseResultMap" type="com.mall.entity.Bill">
        <id column="id" property="id"/>
        <result column="bill_no" property="billNo"/>
        <result column="type" property="type"/>
        <result column="amount" property="amount"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="order_id" property="orderId"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="order_no" property="orderNo"/>
    </resultMap>
    
    <sql id="Base_Column_List">
        b.id, b.bill_no, b.type, b.amount, b.title, b.description, b.order_id, b.status, b.create_time
    </sql>
    
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>, o.order_no
        FROM bill b
        LEFT JOIN `order` o ON b.order_id = o.id
        WHERE b.id = #{id}
    </select>
    
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>, o.order_no
        FROM bill b
        LEFT JOIN `order` o ON b.order_id = o.id
        <where>
            <if test="type != null">
                AND b.type = #{type}
            </if>
            <if test="startTime != null and startTime != ''">
                AND b.create_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND b.create_time &lt;= #{endTime}
            </if>
        </where>
        ORDER BY b.create_time DESC
    </select>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bill (bill_no, type, amount, title, description, order_id, status)
        VALUES (#{billNo}, #{type}, #{amount}, #{title}, #{description}, #{orderId}, #{status})
    </insert>
    
    <update id="update">
        UPDATE bill
        <set>
            <if test="type != null">type = #{type},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="title != null">title = #{title},</if>
            <if test="description != null">description = #{description},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM bill WHERE id = #{id}
    </delete>
    
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM bill
    </select>
</mapper>
