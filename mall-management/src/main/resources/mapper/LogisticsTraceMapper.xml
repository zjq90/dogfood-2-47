<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.mapper.LogisticsTraceMapper">
    
    <resultMap id="BaseResultMap" type="com.mall.entity.LogisticsTrace">
        <id column="id" property="id"/>
        <result column="logistics_id" property="logisticsId"/>
        <result column="location" property="location"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    
    <sql id="Base_Column_List">
        id, logistics_id, location, description, create_time
    </sql>
    
    <select id="selectByLogisticsId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM logistics_trace 
        WHERE logistics_id = #{logisticsId}
        ORDER BY create_time DESC
    </select>
    
    <insert id="insert" parameterType="com.mall.entity.LogisticsTrace" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO logistics_trace (logistics_id, location, description)
        VALUES (#{logisticsId}, #{location}, #{description})
    </insert>
    
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO logistics_trace (logistics_id, location, description)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.logisticsId}, #{item.location}, #{item.description})
        </foreach>
    </insert>
    
    <delete id="deleteByLogisticsId">
        DELETE FROM logistics_trace WHERE logistics_id = #{logisticsId}
    </delete>
</mapper>
